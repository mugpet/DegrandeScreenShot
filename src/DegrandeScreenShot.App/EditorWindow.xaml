                                <Line X1="14" Y1="9" X2="16.5" Y2="9" Stroke="{DynamicResource IslandTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Line X1="3.4" Y1="3.4" X2="5.1" Y2="5.1" Stroke="{DynamicResource IslandTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Line X1="12.9" Y1="12.9" X2="14.6" Y2="14.6" Stroke="{DynamicResource IslandTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Line X1="12.9" Y1="5.1" X2="14.6" Y2="3.4" Stroke="{DynamicResource IslandTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Line X1="3.4" Y1="14.6" X2="5.1" Y2="12.9" Stroke="{DynamicResource IslandTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Grid>
                    </Button>
                    <Border Width="1" Height="20" Margin="6,0" Background="{DynamicResource IslandDividerBrush}" />
                    <TextBlock x:Name="ZoomPercentText" MinWidth="37" Margin="2,0,4,0" TextAlignment="Center" VerticalAlignment="Center"
                               FontSize="11" Foreground="{DynamicResource IslandMutedTextBrush}" />
                    <Button Click="ZoomActualSize_Click" Style="{StaticResource EditorTopBarButtonStyle}" ToolTip="Zoom to 100% image size" Margin="2,0,0,0" Width="32" Height="28">
                        <Grid Width="20" Height="18">
                            <TextBlock Text="1:1"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}" />
                        </Grid>
                    </Button>
                    <Button x:Name="ZoomFitButton" Click="ZoomFitToView_Click" Style="{StaticResource EditorTopBarButtonStyle}" ToolTip="Fit image to view" Margin="2,0,0,0" Width="32" Height="28">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="18" Height="18">
                                <Rectangle Width="12" Height="9" Canvas.Left="3" Canvas.Top="4.5"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           Stroke="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}"
                                           StrokeThickness="1.6" />
                                <Path Stroke="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M1.8,6.5 L1.8,2.2 L6.1,2.2 M11.9,2.2 L16.2,2.2 L16.2,6.5 M16.2,11.5 L16.2,15.8 L11.9,15.8 M6.1,15.8 L1.8,15.8 L1.8,11.5" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ActiveToolText" FontWeight="SemiBold" Foreground="{DynamicResource IslandTextBrush}" />
                    <Border Width="1" Height="20" Margin="6,0" Background="{DynamicResource IslandDividerBrush}" />
                    <TextBlock x:Name="ImageDimensionsText" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource IslandMutedTextBrush}" />
                    <TextBlock x:Name="ExportStatus" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource IslandTextBrush}" Visibility="Collapsed"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
