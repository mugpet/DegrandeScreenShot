<Window x:Class="DegrandeScreenShot.App.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Capture"
        Width="940"
        Height="560"
        MinWidth="620"
        MinHeight="420"
        Background="{DynamicResource ShellBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        PreviewDragOver="EditorWindow_PreviewDragOver"
        PreviewDrop="EditorWindow_PreviewDrop"
        PreviewKeyDown="EditorWindow_PreviewKeyDown"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DoubleAnimation x:Key="InspectorContentFade" From="0.84" To="1" Duration="0:0:0.10" FillBehavior="Stop" />
        <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#19212A" />
        <SolidColorBrush x:Key="EditorWorkspaceBrush" Color="#202933" />
        <SolidColorBrush x:Key="IslandBackgroundBrush" Color="#242E38" />
        <SolidColorBrush x:Key="IslandBorderBrush" Color="#435260" />
        <SolidColorBrush x:Key="IslandButtonBrush" Color="#2C3743" />
        <SolidColorBrush x:Key="IslandButtonHoverBrush" Color="#3B4B5A" />
        <SolidColorBrush x:Key="IslandButtonPressedBrush" Color="#455B6A" />
        <SolidColorBrush x:Key="IslandButtonActiveBrush" Color="#164251" />
        <SolidColorBrush x:Key="IslandButtonActiveBorderBrush" Color="#449AAF" />
        <SolidColorBrush x:Key="EditorFocusBrush" Color="#99E0EF" />
        <SolidColorBrush x:Key="IslandTextBrush" Color="#EFF5F8" />
        <SolidColorBrush x:Key="IslandMutedTextBrush" Color="#B6C3CE" />
        <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#10718B" />
        <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="#3C8FA6" />
        <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#0F7891" />
        <SolidColorBrush x:Key="PrimaryButtonPressedBrush" Color="#175F74" />
        <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#2E3B47" />
        <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="#506171" />
        <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#3B4B59" />
        <SolidColorBrush x:Key="SecondaryButtonPressedBrush" Color="#455867" />
        <SolidColorBrush x:Key="InlineTextInputBackgroundBrush" Color="#D91A1E25" />
        <SolidColorBrush x:Key="InlineTextInputBorderBrush" Color="#66CCF3FF" />
        <SolidColorBrush x:Key="InlineTextInputForegroundBrush" Color="#FFF4F7FB" />
        <SolidColorBrush x:Key="DeleteButtonBackgroundBrush" Color="#3AD94841" />
        <SolidColorBrush x:Key="DeleteButtonBorderBrush" Color="#80FFB0AA" />
        <SolidColorBrush x:Key="DeleteButtonForegroundBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="IslandDividerBrush" Color="#445463" />
        <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#2B252C36" />
        <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#768693A2" />
        <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#9AA1ADBA" />
        <SolidColorBrush x:Key="ScrollBarThumbPressedBrush" Color="#C0B7C3CF" />
        <SolidColorBrush x:Key="EditorSliderTrackBrush" Color="#4A5B69" />
        <SolidColorBrush x:Key="EditorSliderFillBrush" Color="#5EBBD1" />
        <SolidColorBrush x:Key="EditorSliderFillHoverBrush" Color="#99E0EF" />
        <SolidColorBrush x:Key="EditorSliderThumbBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="EditorSliderThumbBorderBrush" Color="#8599A6" />

        <Style x:Key="EditorKeyboardFocusStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border Margin="-2" BorderThickness="2" CornerRadius="8"
                                BorderBrush="{DynamicResource EditorFocusBrush}"
                                IsHitTestVisible="False" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorButtonBaseStyle" TargetType="ButtonBase">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource IslandTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource IslandButtonBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource EditorKeyboardFocusStyle}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="350" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource IslandButtonHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource IslandBorderBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource IslandButtonPressedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditorPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource EditorButtonBaseStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonPressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditorSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource EditorButtonBaseStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SecondaryButtonHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SecondaryButtonPressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditorTopBarButtonStyle" TargetType="Button" BasedOn="{StaticResource EditorButtonBaseStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
        </Style>

        <Style x:Key="EditorTopBarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource EditorPrimaryButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="EditorDeleteIconButtonStyle" TargetType="Button" BasedOn="{StaticResource EditorButtonBaseStyle}">
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Background" Value="{DynamicResource DeleteButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DeleteButtonBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DeleteButtonForegroundBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DeleteButtonBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DeleteButtonForegroundBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DeleteButtonBackgroundBrush}" />
                    <Setter Property="Opacity" Value="0.78" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditorTopBarToolButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource EditorButtonBaseStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource IslandButtonActiveBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource IslandButtonActiveBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1,1,1,3" />
                    <Setter Property="Foreground" Value="{DynamicResource EditorFocusBrush}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsChecked" Value="True" />
                        <Condition Property="IsPressed" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource EditorFocusBrush}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditorIconLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}" />
        </Style>

        <Style x:Key="EditorGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}" />
        </Style>

        <Style x:Key="EditorSliderTrackButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="{DynamicResource EditorSliderTrackBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorSliderFillButtonStyle" TargetType="RepeatButton" BasedOn="{StaticResource EditorSliderTrackButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource EditorSliderFillBrush}" />
        </Style>

        <Style x:Key="EditorSliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="ThumbSurface" Width="14" Height="14"
                                     Fill="{DynamicResource EditorSliderThumbBrush}"
                                     Stroke="{DynamicResource EditorSliderThumbBorderBrush}" StrokeThickness="1.5" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Stroke" Value="{DynamicResource EditorSliderFillHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Stroke" Value="{DynamicResource EditorSliderFillHoverBrush}" />
                                <Setter TargetName="ThumbSurface" Property="StrokeThickness" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{StaticResource EditorKeyboardFocusStyle}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource EditorSliderFillBrush}" />
            <Setter Property="Background" Value="{DynamicResource EditorSliderTrackBrush}" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track"
                                   Height="20"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  Style="{StaticResource EditorSliderFillButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Style="{StaticResource EditorSliderTrackButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource EditorSliderThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorScrollRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Border x:Name="ThumbSurface"
                                    Margin="3"
                                    Background="{DynamicResource ScrollBarThumbBrush}"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource ScrollBarThumbPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal">
                    <Setter Property="MinWidth" Value="28" />
                    <Setter Property="MinHeight" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Background" Value="{DynamicResource ScrollBarTrackBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="ScrollBarRoot"
                              Width="12"
                              Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="DecreaseButton"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Style="{StaticResource EditorScrollRepeatButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource EditorScrollBarThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="IncreaseButton"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Style="{StaticResource EditorScrollRepeatButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="ScrollBarRoot" Property="Width" Value="Auto" />
                                <Setter TargetName="ScrollBarRoot" Property="Height" Value="12" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="DecreaseButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                                <Setter TargetName="IncreaseButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ScrollBarTrackBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="12" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="EditorRootGrid" Background="{DynamicResource EditorWorkspaceBrush}" SizeChanged="Workspace_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="FileActionsIsland" Grid.Row="0" Padding="9,5"
                Background="{DynamicResource IslandBackgroundBrush}" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <ToggleButton x:Name="InspectorToggle" DockPanel.Dock="Right" Width="Auto" Padding="8,0" IsChecked="True" Click="InspectorToggle_Click"
                              Style="{StaticResource EditorTopBarToolButtonStyle}" ToolTip="Hide properties">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource EditorGlyphStyle}" Text="&#xE89F;" Margin="0" FontSize="16" />
                        <TextBlock x:Name="PropertiesButtonLabel" Text="Properties" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12" />
                    </StackPanel>
                </ToggleButton>
                <StackPanel Orientation="Horizontal">
                    <StackPanel x:Name="ExportButtons" Orientation="Horizontal">
                        <Button Click="Copy_Click" ToolTip="Copy" AutomationProperties.Name="Copy" Width="Auto" Padding="9,0" Margin="0,0,3,0" Style="{StaticResource EditorTopBarPrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource EditorGlyphStyle}" FontSize="15" Margin="0,0,6,0" Text="&#xE8C8;" />
                                <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="Copy" />
                            </StackPanel>
                        </Button>
                        <Button Click="Save_Click" ToolTip="Save" AutomationProperties.Name="Save" Width="Auto" Padding="9,0" Margin="0,0,3,0" Style="{StaticResource EditorTopBarButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource EditorGlyphStyle}" FontSize="15" Margin="0,0,6,0" Text="&#xE74E;" />
                                <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="Save" />
                            </StackPanel>
                        </Button>
                        <Button Click="SaveAs_Click" ToolTip="Save As" Style="{StaticResource EditorTopBarButtonStyle}" Margin="0,0,2,0">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="20" Height="20">
                                    <Path Data="M3,2.5 L12.5,2.5 L16.5,6.5 L16.5,11.5 M3,2.5 L3,17.5 L10,17.5 M12.5,2.5 L12.5,6.5 L16.5,6.5"
                                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                    <Path Data="M10.8,16.8 L11.5,13.9 L16.1,9.3 C16.6,8.8 17.4,8.8 17.9,9.3 C18.4,9.8 18.4,10.6 17.9,11.1 L13.3,15.7 Z"
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                    <Border Width="1" Height="20" Margin="6,0" Background="{DynamicResource IslandDividerBrush}" />
                    <Button Click="AddImageFromFile_Click" Style="{StaticResource EditorTopBarButtonStyle}" ToolTip="Add image from file" Margin="0,0,2,0">
                        <TextBlock Style="{StaticResource EditorGlyphStyle}" FontSize="18" Margin="0" Text="&#xE8B9;" />
                    </Button>
                    <Button x:Name="AddImageFromUrlButton"
                            Click="AddImageFromUrlButton_Click"
                            Style="{StaticResource EditorTopBarButtonStyle}"
                            ToolTip="Add image from URL" Margin="0,0,2,0">
                        <TextBlock Style="{StaticResource EditorGlyphStyle}" FontSize="18" Margin="0" Text="&#xE71B;" />
                    </Button>
                    <Button
                            Click="ShowGallery_Click"
                            Style="{StaticResource EditorTopBarButtonStyle}"
                            ToolTip="Show image gallery" Margin="0,0,2,0">
                        <TextBlock Style="{StaticResource EditorGlyphStyle}" FontSize="18" Margin="0" Text="&#xE91B;" />
                    </Button>
                    <Button x:Name="ResizeImageButton"
                            Click="ResizeImageButton_Click"
                            Style="{StaticResource EditorTopBarButtonStyle}"
                            ToolTip="Resize screenshot or selected image" Width="76" Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Viewbox Width="17" Height="17">
                                <Canvas Width="18" Height="18">
                                    <Path Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M2.5,7 V2.5 H7 M2.8,2.8 L8,8 M11,15.5 H15.5 V11 M10,10 L15.2,15.2" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Margin="7,0,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Text="Resize" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="20" Margin="6,0" Background="{DynamicResource IslandDividerBrush}" />
                    <Button x:Name="UndoHistoryButton" Click="UndoHistory_Click" Style="{StaticResource EditorTopBarButtonStyle}" ToolTip="Undo (Ctrl+Z)" Margin="0,0,2,0">
                        <TextBlock Style="{StaticResource EditorGlyphStyle}" FontSize="18" Margin="0" Text="&#xE7A7;" />
                    </Button>
                    <Button x:Name="RedoHistoryButton" Click="RedoHistory_Click" Style="{StaticResource EditorTopBarButtonStyle}" ToolTip="Redo (Ctrl+Y)" Margin="0,0,2,0">
                        <TextBlock Style="{StaticResource EditorGlyphStyle}" FontSize="18" Margin="0" Text="&#xE7A6;" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <DockPanel Grid.Row="1">
            <Border x:Name="ToolbarIsland" DockPanel.Dock="Left" Width="50" Padding="4,7" Background="{DynamicResource IslandBackgroundBrush}"
                    BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel HorizontalAlignment="Center">
                        <RadioButton GroupName="AnnotationTools" x:Name="SelectToolButton" Style="{StaticResource EditorTopBarToolButtonStyle}" Checked="ToolButton_Checked" Tag="Select" ToolTip="Select" Margin="0,0,0,3">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="16" Height="16">
                                    <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}"
                                          Data="M2,1 L10.4,8.1 L6.9,8.7 L8.9,13.9 L6.8,15 L4.8,9.7 L2,12.3 Z" />
                                </Canvas>
                            </Viewbox>
                        </RadioButton>
                        <RadioButton GroupName="AnnotationTools" x:Name="CropToolButton" Style="{StaticResource EditorTopBarToolButtonStyle}" Checked="ToolButton_Checked" Tag="Crop" ToolTip="Crop" Margin="0,0,0,3">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="16" Height="16">
                                    <Path Stroke="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M4,1 V11 M1,4 H11 M12,5 V15 M5,12 H15" />
                                </Canvas>
                            </Viewbox>
                        </RadioButton>
                        <RadioButton GroupName="AnnotationTools" x:Name="ArrowToolButton" Style="{StaticResource EditorTopBarToolButtonStyle}" Checked="ToolButton_Checked" Tag="Arrow" ToolTip="Arrow" Margin="0,0,0,3">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="16" Height="16">
                                    <Path Stroke="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M2,13 L13,2 M8.5,2 H13 V6.5" />
                                </Canvas>
                            </Viewbox>
                        </RadioButton>
                        <RadioButton GroupName="AnnotationTools" x:Name="RectangleToolButton" Style="{StaticResource EditorTopBarToolButtonStyle}" Checked="ToolButton_Checked" Tag="Rectangle" ToolTip="Frame" Margin="0,0,0,3">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="16" Height="16">
                                    <Rectangle Width="12" Height="9" Canvas.Left="2" Canvas.Top="3.5"
                                               RadiusX="1"
                                               RadiusY="1"
                                               Stroke="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}"
                                               StrokeThickness="1.7" />
                                </Canvas>
                            </Viewbox>
                        </RadioButton>
                        <RadioButton GroupName="AnnotationTools" x:Name="EllipseToolButton" Style="{StaticResource EditorTopBarToolButtonStyle}" Checked="ToolButton_Checked" Tag="Ellipse" ToolTip="Circle" Margin="0,0,0,3">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="16" Height="16">
                                    <Ellipse Width="11" Height="11" Canvas.Left="2.5" Canvas.Top="2.5"
                                             Stroke="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}"
                                             StrokeThickness="1.7" />
                                </Canvas>
                            </Viewbox>
                        </RadioButton>
                        <RadioButton GroupName="AnnotationTools" x:Name="ObscureToolButton" Style="{StaticResource EditorTopBarToolButtonStyle}" Checked="ToolButton_Checked" Tag="Obscure" ToolTip="Obscure sensitive content" Margin="0,0,0,3">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="16" Height="16">
                                    <Rectangle Width="11.5" Height="8.5" Canvas.Left="2.25" Canvas.Top="3.75"
                                               RadiusX="1.6"
                                               RadiusY="1.6"
                                               Fill="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}"
                                               Opacity="0.16"
                                               Stroke="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}"
                                               StrokeThickness="1.5" />
                                    <Line X1="4" Y1="6.5" X2="12" Y2="6.5"
                                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}"
                                          StrokeThickness="1.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeDashArray="1.2,1.1" />
                                    <Line X1="4" Y1="9.5" X2="12" Y2="9.5"
                                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}"
                                          StrokeThickness="1.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeDashArray="1.2,1.1" />
                                    <Path Stroke="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M2.4,13.6 L13.6,2.4" />
                                </Canvas>
                            </Viewbox>
                        </RadioButton>
                        <RadioButton GroupName="AnnotationTools" x:Name="HighlightToolButton" Style="{StaticResource EditorTopBarToolButtonStyle}" Checked="ToolButton_Checked" Click="HighlightToolButton_Click" Tag="Highlight" ToolTip="Area highlight" Margin="0,0,0,3">
                            <Grid Width="18" Height="18">
                                <Viewbox x:Name="HighlightAreaToolIcon" Width="18" Height="18">
                                    <Canvas Width="16" Height="16">
                                        <Rectangle Width="11.5" Height="7.5" Canvas.Left="2.25" Canvas.Top="4.25"
                                                   RadiusX="2"
                                                   RadiusY="2"
                                                   Fill="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}"
                                                   Opacity="0.24" />
                                        <Rectangle Width="11.5" Height="7.5" Canvas.Left="2.25" Canvas.Top="4.25"
                                                   RadiusX="2"
                                                   RadiusY="2"
                                                   Stroke="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}"
                                                   StrokeThickness="1.5" />
                                    </Canvas>
                                </Viewbox>
                                <Viewbox x:Name="HighlightLineToolIcon" Width="18" Height="18" Visibility="Collapsed">
                                    <Canvas Width="16" Height="16">
                                        <Line X1="2.5" Y1="8" X2="13.5" Y2="8"
                                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}"
                                              StrokeThickness="5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Opacity="0.25" />
                                        <Line X1="2.5" Y1="8" X2="13.5" Y2="8"
                                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                                <Viewbox x:Name="HighlightFreehandToolIcon" Width="18" Height="18" Visibility="Collapsed">
                                    <Canvas Width="16" Height="16">
                                        <Path Stroke="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}"
                                              StrokeThickness="5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Opacity="0.25"
                                              Data="M2.2,9.5 C4.3,5.3 6.2,13.2 8.3,8.2 C9.5,5.1 11.5,5.4 13.8,7" />
                                        <Path Stroke="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Data="M2.2,9.5 C4.3,5.3 6.2,13.2 8.3,8.2 C9.5,5.1 11.5,5.4 13.8,7" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </RadioButton>
                        <RadioButton GroupName="AnnotationTools" x:Name="TextToolButton" Style="{StaticResource EditorTopBarToolButtonStyle}" Checked="ToolButton_Checked" Tag="Text" ToolTip="Text" Margin="0,0,0,3">
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}"
                                       Text="T" />
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border x:Name="InspectorDock" DockPanel.Dock="Right" Width="252"
                    Background="{DynamicResource IslandBackgroundBrush}" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border x:Name="InspectorHeader" DockPanel.Dock="Top" Padding="12,6" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button x:Name="InspectorBackButton" DockPanel.Dock="Right" Style="{StaticResource EditorTopBarButtonStyle}" Width="28" Height="28"
                                    ToolTip="Hide properties" Click="CloseInspectorPage_Click">
                                <TextBlock x:Name="InspectorBackGlyph" Style="{StaticResource EditorGlyphStyle}" Margin="0" Text="&#xE711;" />
                            </Button>
                            <TextBlock x:Name="InspectorHeading" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource IslandTextBrush}" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer x:Name="InspectorScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel x:Name="InspectorContent" Margin="12,10" MaxWidth="440" HorizontalAlignment="Stretch">
                            <StackPanel x:Name="PropertiesPanel">
                                <StackPanel x:Name="DocumentOverviewPanel" Visibility="Collapsed" Margin="0,3,0,4">
                                    <DockPanel>
                                        <Button x:Name="DocumentResizeButton" DockPanel.Dock="Right" Margin="8,0,0,0"
                                                VerticalAlignment="Center" Content="Resize" AutomationProperties.Name="Resize image"
                                                Style="{StaticResource EditorSecondaryButtonStyle}" Click="ResizeImageButton_Click" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Image size" FontSize="12" Foreground="{DynamicResource IslandMutedTextBrush}" />
                                            <TextBlock x:Name="DocumentDimensions" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource IslandTextBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock x:Name="DocumentAnnotationCount" Margin="0,7,0,0" FontSize="12"
                                               Foreground="{DynamicResource IslandMutedTextBrush}" />
                                </StackPanel>
                                <StackPanel x:Name="CropActionsPanel" Visibility="Collapsed">
                                    <TextBlock Text="Drag to select the area to keep." TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource IslandMutedTextBrush}" />
                                    <WrapPanel>
                                        <Button x:Name="ApplyCropButton" Click="ApplyCrop_Click" Content="Apply crop" Style="{StaticResource EditorPrimaryButtonStyle}" />
                                        <Button x:Name="CancelCropButton" Click="CancelCrop_Click" Content="Cancel" Margin="5,0,0,0" Style="{StaticResource EditorSecondaryButtonStyle}" />
                                        <Button x:Name="UndoCropButton" Click="UndoCrop_Click" Content="Undo" Margin="5,0,0,0" Style="{StaticResource EditorSecondaryButtonStyle}" />
                                    </WrapPanel>
                                </StackPanel>
                                <TextBlock x:Name="InspectorHint" TextWrapping="Wrap" Foreground="{DynamicResource IslandMutedTextBrush}" Margin="0,0,0,8" />
                                <Border x:Name="SelectionActionIsland" Visibility="Collapsed">
                                    <StackPanel>
                                        <StackPanel.Resources>
                                            <Style x:Key="InspectorLabel" TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Foreground" Value="{DynamicResource IslandTextBrush}" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                            <Style x:Key="InspectorValue" TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12" />
                                                <Setter Property="Foreground" Value="{DynamicResource IslandMutedTextBrush}" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="TextAlignment" Value="Right" />
                                            </Style>
                                            <Style x:Key="InspectorSwatch" TargetType="RadioButton">
                                                <Setter Property="Height" Value="30" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="GroupName" Value="AnnotationColor" />
                                                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(AutomationProperties.Name)}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border Background="Transparent">
                                                                <Border x:Name="Ring" Width="22" Height="22" BorderThickness="1.5" CornerRadius="11" Padding="2">
                                                                    <Border Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="#768595" CornerRadius="8" />
                                                                </Border>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource IslandMutedTextBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource IslandTextBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource IslandButtonActiveBorderBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                            <Style x:Key="InspectorDetails" TargetType="Expander">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Foreground" Value="{DynamicResource IslandTextBrush}" />
                                                <Setter Property="Margin" Value="0,8,0,0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Expander">
                                                            <StackPanel>
                                                                <ToggleButton x:Name="HeaderSite" Height="32" HorizontalContentAlignment="Stretch"
                                                                              Background="{DynamicResource IslandButtonBrush}" Foreground="{TemplateBinding Foreground}"
                                                                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                                                    <ToggleButton.Template>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border x:Name="HeaderBorder" CornerRadius="6" Background="{TemplateBinding Background}"
                                                                                    BorderThickness="1" Padding="8,0" BorderBrush="{DynamicResource IslandBorderBrush}">
                                                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource IslandButtonHoverBrush}" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                    <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource IslandButtonActiveBorderBrush}" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </ToggleButton.Template>
                                                                    <DockPanel>
                                                                        <Path x:Name="Chevron" DockPanel.Dock="Right" Width="8" Height="8" VerticalAlignment="Center"
                                                                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeLineJoin="Round"
                                                                              RenderTransformOrigin="0.5,0.5" Data="M2,0.75 L5.5,4 L2,7.25" />
                                                                        <ContentPresenter ContentSource="Header" TextElement.FontSize="12" TextElement.FontWeight="SemiBold" />
                                                                    </DockPanel>
                                                                </ToggleButton>
                                                                <ContentPresenter x:Name="Details" Visibility="Collapsed" />
                                                            </StackPanel>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsExpanded" Value="True">
                                                                    <Setter TargetName="Details" Property="Visibility" Value="Visible" />
                                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                                        <Setter.Value><RotateTransform Angle="90" /></Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </StackPanel.Resources>
                                        <DockPanel LastChildFill="True">
                                            <StackPanel x:Name="ObjectScalePanel" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,9">
                                                <DockPanel>
                                                    <TextBlock Text="Size" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource IslandTextBrush}" />
                                                    <TextBlock x:Name="ObjectScaleValueLabel" HorizontalAlignment="Right" Foreground="{DynamicResource IslandMutedTextBrush}" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <DockPanel>
                                                    <Button x:Name="ResetScaleButton" DockPanel.Dock="Right" Click="ResetScaleButton_Click" Style="{StaticResource EditorTopBarButtonStyle}"
                                                            ToolTip="Reset size to 100%" AutomationProperties.Name="Reset size to 100%" Width="28" Height="28" Margin="6,0,0,0">
                                                        <TextBlock Style="{StaticResource EditorGlyphStyle}" Margin="0" FontSize="13" Text="&#xE72C;" />
                                                    </Button>
                                                    <Slider x:Name="ObjectScaleSlider"
                                                            Minimum="0.1"
                                                            Maximum="3.0"
                                                            SmallChange="0.05"
                                                            LargeChange="0.2"
                                                            TickFrequency="0.05"
                                                            IsSnapToTickEnabled="False"
                                                            ValueChanged="ObjectScaleSlider_ValueChanged"
                                                            ToolTip="Object size"  HorizontalAlignment="Stretch"  AutomationProperties.Name="Object size" />
                                                </DockPanel>
                                            </StackPanel>
                                            <StackPanel x:Name="ColorActionPanel" DockPanel.Dock="Top">
                                                <DockPanel>
                                                    <TextBlock x:Name="CurrentColorValue" DockPanel.Dock="Right" Style="{StaticResource InspectorValue}" />
                                                    <TextBlock Text="Color" Style="{StaticResource InspectorLabel}" />
                                                </DockPanel>
                                                <UniformGrid x:Name="ColorChoices" Rows="1" Columns="9" Margin="0,2,0,2">
                                                    <RadioButton Style="{StaticResource InspectorSwatch}" Background="#0A7A68" AutomationProperties.Name="Teal" Click="ColorOption_Click" />
                                                    <RadioButton Style="{StaticResource InspectorSwatch}" Background="#F5D90A" AutomationProperties.Name="Yellow" Click="ColorOption_Click" />
                                                    <RadioButton Style="{StaticResource InspectorSwatch}" Background="#F08C00" AutomationProperties.Name="Orange" Click="ColorOption_Click" />
                                                    <RadioButton Style="{StaticResource InspectorSwatch}" Background="#D94841" AutomationProperties.Name="Red" Click="ColorOption_Click" />
                                                    <RadioButton Style="{StaticResource InspectorSwatch}" Background="#EC4899" AutomationProperties.Name="Pink" Click="ColorOption_Click" />
                                                    <RadioButton Style="{StaticResource InspectorSwatch}" Background="#06B6D4" AutomationProperties.Name="Cyan" Click="ColorOption_Click" />
                                                    <RadioButton Style="{StaticResource InspectorSwatch}" Background="#7C3AED" AutomationProperties.Name="Violet" Click="ColorOption_Click" />
                                                    <RadioButton Style="{StaticResource InspectorSwatch}" Background="#2563EB" AutomationProperties.Name="Blue" Click="ColorOption_Click" />
                                                    <RadioButton Style="{StaticResource InspectorSwatch}" Background="#111827" AutomationProperties.Name="Ink" Click="ColorOption_Click" />
                                                </UniformGrid>
                                            </StackPanel>
                                            <StackPanel x:Name="ArrowheadPanel" Visibility="{Binding Visibility, ElementName=ArrowOptionsPanel}">
                                                <TextBlock Text="Arrowheads" Style="{StaticResource InspectorLabel}" Margin="0,0,0,5" />
                                                <UniformGrid Rows="1" Columns="2">
                                                    <ToggleButton x:Name="ArrowTailToggleButton" Content="Start" Height="30" Width="Auto" Margin="1,0" Padding="4,0" Style="{StaticResource EditorTopBarToolButtonStyle}" Checked="ArrowTailToggleButton_Checked" Unchecked="ArrowTailToggleButton_Checked" ToolTip="Add an arrow head to the tail" AutomationProperties.Name="Add an arrow head to the tail" />
                                                    <ToggleButton x:Name="ArrowHeadToggleButton" Content="End" Height="30" Width="Auto" Margin="1,0" Padding="4,0" Style="{StaticResource EditorTopBarToolButtonStyle}" Checked="ArrowHeadToggleButton_Checked" Unchecked="ArrowHeadToggleButton_Checked" ToolTip="Toggle the front arrow head" AutomationProperties.Name="Toggle the front arrow head" />
                                                </UniformGrid>
                                            </StackPanel>
                                        </DockPanel>
                                        <StackPanel x:Name="ArrowOptionsPanel" Visibility="Collapsed">
                                            <UniformGrid x:Name="ArrowWidthFields" Columns="1">
                                                <StackPanel x:Name="ArrowBodyProperty" Margin="0,6,0,0">
                                                    <DockPanel>
                                                        <TextBlock x:Name="ArrowBodyValueLabel" DockPanel.Dock="Right" Style="{StaticResource InspectorValue}" Text="1.0" />
                                                        <TextBlock Style="{StaticResource InspectorLabel}" Text="Body width" />
                                                    </DockPanel>
                                                    <Slider x:Name="ArrowBodySlider" Minimum="0.15" Maximum="3.0" SmallChange="0.05" LargeChange="0.25" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="ArrowBodySlider_ValueChanged" AutomationProperties.Name="Body width" ToolTip="Body width" />
                                                </StackPanel>
                                                <StackPanel x:Name="ArrowHeadProperty" Margin="0,6,0,0">
                                                    <DockPanel>
                                                        <TextBlock x:Name="ArrowHeadValueLabel" DockPanel.Dock="Right" Style="{StaticResource InspectorValue}" Text="1.0" />
                                                        <TextBlock Style="{StaticResource InspectorLabel}" Text="End head size" />
                                                    </DockPanel>
                                                    <Slider x:Name="ArrowHeadSlider" Minimum="0.2" Maximum="1.6" SmallChange="0.05" LargeChange="0.2" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="ArrowHeadSlider_ValueChanged" AutomationProperties.Name="End head size" ToolTip="End head size" />
                                                </StackPanel>
                                            </UniformGrid>
                                            <Expander x:Name="ArrowGeometryExpander" Header="Shape details" Style="{StaticResource InspectorDetails}">
                                                <StackPanel>
                                                    <StackPanel Margin="0,6,0,0">
                                                        <DockPanel>
                                                            <TextBlock x:Name="ArrowTailValueLabel" DockPanel.Dock="Right" Style="{StaticResource InspectorValue}" Text="1.0" />
                                                            <TextBlock Style="{StaticResource InspectorLabel}" Text="Tail width" />
                                                        </DockPanel>
                                                        <Slider x:Name="ArrowTailSlider" Minimum="0.15" Maximum="3.0" SmallChange="0.05" LargeChange="0.25" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="ArrowTailSlider_ValueChanged" AutomationProperties.Name="Tail width" ToolTip="Tail width" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,6,0,0">
                                                        <DockPanel>
                                                            <TextBlock x:Name="ArrowFrontValueLabel" DockPanel.Dock="Right" Style="{StaticResource InspectorValue}" Text="1.0" />
                                                            <TextBlock Style="{StaticResource InspectorLabel}" Text="Front width" />
                                                        </DockPanel>
                                                        <Slider x:Name="ArrowFrontSlider" Minimum="0.15" Maximum="3.0" SmallChange="0.05" LargeChange="0.25" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="ArrowFrontSlider_ValueChanged" AutomationProperties.Name="Front width" ToolTip="Front width" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,6,0,0">
                                                        <DockPanel>
                                                            <TextBlock x:Name="ArrowTailHeadValueLabel" DockPanel.Dock="Right" Style="{StaticResource InspectorValue}" Text="1.0" />
                                                            <TextBlock Style="{StaticResource InspectorLabel}" Text="Start head size" />
                                                        </DockPanel>
                                                        <Slider x:Name="ArrowTailHeadSlider" Minimum="0.2" Maximum="1.6" SmallChange="0.05" LargeChange="0.2" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="ArrowTailHeadSlider_ValueChanged" AutomationProperties.Name="Start head size" ToolTip="Start head size" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,6,0,0">
                                                        <DockPanel>
                                                            <TextBlock x:Name="ArrowTailRoundnessValueLabel" DockPanel.Dock="Right" Style="{StaticResource InspectorValue}" Text="0%" />
                                                            <TextBlock Style="{StaticResource InspectorLabel}" Text="Tail roundness" />
                                                        </DockPanel>
                                                        <Slider x:Name="ArrowTailRoundnessSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="False" ValueChanged="ArrowTailRoundnessSlider_ValueChanged" AutomationProperties.Name="Tail roundness" ToolTip="Tail roundness" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,6,0,0">
                                                        <DockPanel>
                                                            <TextBlock x:Name="ArrowHeadRoundnessValueLabel" DockPanel.Dock="Right" Style="{StaticResource InspectorValue}" Text="0%" />
                                                            <TextBlock Style="{StaticResource InspectorLabel}" Text="Head roundness" />
                                                        </DockPanel>
                                                        <Slider x:Name="ArrowHeadRoundnessSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="False" ValueChanged="ArrowHeadRoundnessSlider_ValueChanged" AutomationProperties.Name="Head roundness" ToolTip="Head roundness" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,6,0,0">
                                                        <DockPanel>
                                                            <TextBlock x:Name="ArrowBorderValueLabel" DockPanel.Dock="Right" Style="{StaticResource InspectorValue}" Text="2.0" />
                                                            <TextBlock Style="{StaticResource InspectorLabel}" Text="Outline width" />
                                                        </DockPanel>
                                                        <Slider x:Name="ArrowBorderSlider" Minimum="0" Maximum="12" SmallChange="0.25" LargeChange="1" TickFrequency="0.25" IsSnapToTickEnabled="False" ValueChanged="ArrowBorderSlider_ValueChanged" AutomationProperties.Name="Outline width" ToolTip="Outline width" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,6,0,0">
                                                        <DockPanel>
                                                            <TextBlock x:Name="ArrowShadowValueLabel" DockPanel.Dock="Right" Style="{StaticResource InspectorValue}" Text="0%" />
                                                            <TextBlock Style="{StaticResource InspectorLabel}" Text="Drop shadow" />
                                                        </DockPanel>
                                                        <Slider x:Name="ArrowShadowSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="False" ValueChanged="ArrowShadowSlider_ValueChanged" AutomationProperties.Name="Drop shadow" ToolTip="Drop shadow" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                        <StackPanel x:Name="TextSizePanel" Visibility="Collapsed" Margin="0,6,0,0">
                                            <DockPanel>
                                                <TextBlock x:Name="TextFontSizeValueText" DockPanel.Dock="Right" Style="{StaticResource InspectorValue}" Text="26" />
                                                <TextBlock Style="{StaticResource InspectorLabel}" Text="Text size" />
                                            </DockPanel>
                                            <Slider x:Name="TextFontSizeSlider" Minimum="12" Maximum="72" Value="26" TickFrequency="1" IsSnapToTickEnabled="False" SmallChange="1" LargeChange="4" ValueChanged="TextFontSizeSlider_ValueChanged" AutomationProperties.Name="Text size" ToolTip="Text size" />
                                        </StackPanel>
                                        <StackPanel x:Name="TextAlignmentPanel" Visibility="Collapsed" Margin="0,6,0,4">
                                            <TextBlock Text="Formatting" Style="{StaticResource InspectorLabel}" Margin="0,0,0,5" />
